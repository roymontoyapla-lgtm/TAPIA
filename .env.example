# ============================================================
# TAPIA - Variables de entorno
# Copia este fichero como ".env" y rellena tus valores reales.
# NUNCA subas el fichero .env a un repositorio git.
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Anthropic (alternativa a OpenAI) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Dropbox (carga automatica de Apple Health) ---
# Crea una app en https://www.dropbox.com/developers/apps
#   - Tipo "Scoped access", acceso "App folder"
#   - Permisos: files.metadata.read y files.content.read
#   - Genera un refresh token con el flujo OAuth (no caduca)
# La app del movil (Health Auto Export) exporta los JSON a esa carpeta.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Alternativa rapida solo para pruebas (caduca en pocas horas):
# DROPBOX_ACCESS_TOKEN=

# --- Entorno ---
# "development" | "production"
TAPIA_ENV=development
